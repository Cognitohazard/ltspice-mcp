{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "include": ["src", "tests", "evals"],
  "typeCheckingMode": "standard",
  "reportMissingImports": true,
  "reportUnusedVariable": "warning",
  "reportPrivateUsage": "warning",
  "executionEnvironments": [
    {
      "root": "evals",
      "extraPaths": ["evals"]
    },
    {
      "root": "tests",
      "extraPaths": [".", "evals"],
      "reportPrivateUsage": "none"
    }
  ]
}
