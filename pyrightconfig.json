{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "include": ["src", "tests"],
  "typeCheckingMode": "standard",
  "reportMissingImports": true,
  "reportUnusedVariable": "warning",
  "reportPrivateUsage": "warning",
  "executionEnvironments": [
    {
      "root": "tests",
      "extraPaths": ["."],
      "reportPrivateUsage": "none"
    }
  ]
}
