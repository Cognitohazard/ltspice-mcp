  "license": "GPL-3.0-or-later",
  "keywords": ["ltspice", "ngspice", "spice", "circuit", "simulation", "eda", "schematic"],
  "mcpServers": {
    "ltspice": {
      "command": "uvx",
      "args": ["ltspice-mcp"]
    }
  }
}
