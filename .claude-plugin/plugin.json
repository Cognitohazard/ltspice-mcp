  "description": "LTspice/ngspice circuit simulation and LTspice .asc schematic editing, exposed as MCP tools. Tracks the latest ltspice-mcp release on PyPI.",
  "author": {
    "name": "cognitohazard"
  },
  "homepage": "https://github.com/cognitohazard/ltspice-mcp",
